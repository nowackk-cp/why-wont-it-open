#include <winres.h>
#include "resource.h"

#define NEDEN_VER_MAJOR @PROJECT_VERSION_MAJOR@
#define NEDEN_VER_MINOR @PROJECT_VERSION_MINOR@
#define NEDEN_VER_PATCH @PROJECT_VERSION_PATCH@

IDI_APP ICON "@CMAKE_CURRENT_SOURCE_DIR@/app.ico"
1 RT_MANIFEST "@CMAKE_CURRENT_SOURCE_DIR@/app.manifest"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION NEDEN_VER_MAJOR, NEDEN_VER_MINOR, NEDEN_VER_PATCH, 0
 PRODUCTVERSION NEDEN_VER_MAJOR, NEDEN_VER_MINOR, NEDEN_VER_PATCH, 0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "CompanyName", "nowackk-cp"
      VALUE "FileDescription", "Why Won't It Open? - finds out why a Windows program does not start"
      VALUE "FileVersion", "@PROJECT_VERSION@"
      VALUE "InternalName", "WhyWontItOpen"
      VALUE "LegalCopyright", "Copyright (c) nowackk-cp"
      VALUE "OriginalFilename", "WhyWontItOpen.exe"
      VALUE "ProductName", "Why Won't It Open?"
      VALUE "ProductVersion", "@PROJECT_VERSION@"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
